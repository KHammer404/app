    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start --lan --dev-client",
    "android": "expo run:android",
    "ios": "EXPO_USE_PRECOMPILED_MODULES=0 expo run:ios --device",
    "ios:release": "EXPO_USE_PRECOMPILED_MODULES=0 EXPO_PUBLIC_ANALYSIS_MODE=device expo run:ios --device --configuration Release",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "test": "vitest run",
    "lint": "expo lint",
    "prepare:vision": "python scripts/prepare_vision.py",
    "prepare:vision:ios": "python3 scripts/prepare_vision.py --ios",
    "eas-build-pre-install": "python3 scripts/prepare_vision.py"
  },
  "private": true
