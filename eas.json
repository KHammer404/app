{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_ANALYSIS_MODE": "device" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_ANALYSIS_MODE": "device" }
    },
    "production": {
      "env": { "EXPO_PUBLIC_ANALYSIS_MODE": "device" }
    }
  }
}
